#!/bin/sh
set -eu

resolve_manager_root()
{
    manager_entrypoint="$0"

    if command -v readlink >/dev/null 2>&1; then
        linked_entrypoint="$(readlink "$manager_entrypoint" 2>/dev/null || true)"
        if [ -n "$linked_entrypoint" ]; then
            case "$linked_entrypoint" in
                /*) manager_entrypoint="$linked_entrypoint" ;;
                *) manager_entrypoint="$(dirname "$manager_entrypoint")/$linked_entrypoint" ;;
            esac
        fi
    fi

    CDPATH= cd -- "$(dirname "$manager_entrypoint")" && pwd
}

MANAGER_ROOT="$(resolve_manager_root)"
LIBRARY_DIR="${MANAGER_ROOT}/manager/lib"

for library in common configuration docker installation lifecycle backup update diagnostics uninstall; do
    library_path="${LIBRARY_DIR}/${library}.sh"
    if [ ! -r "$library_path" ]; then
        printf 'Achelife Manager is incomplete: missing %s\n' "$library_path" >&2
        exit 1
    fi
    . "$library_path"
done

print_help()
{
    cat <<'EOF'
Achelife Manager

Usage:
  achelife [--dir PATH] COMMAND [options]

Commands:
  install                 Install or reconcile an exact Achelife version
  start | stop | restart  Manage the application lifecycle
  status [--json]         Show health, version, storage, and update state
  update [options]        Safely update with backup and rollback protection
  enable | disable        Configure Docker boot restart behavior
  logs [--follow]         Show application service logs
  doctor [--json]         Diagnose the host and installation
  backup                  Create and verify a full-instance backup
  restore FILE            Restore a full-instance operational backup
  open                    Open Achelife in the default browser
  version [--json]        Show manager and installed image versions
  uninstall               Remove the manager while retaining data by default
  help                    Show this command reference

Install options:
  --dir PATH              Installation directory
  --bin-dir PATH          Executable directory (default: $HOME/.local/bin)
  --port PORT             Host port (default: 8080)
  --bind ADDRESS          Bind address (default: 127.0.0.1)
  --project NAME          Compose project identity
  --version VERSION       Exact MAJOR.MINOR.PATCH[-rc.N] version
  --channel stable|rc     Release channel (default: stable)
  --yes                   Non-interactive confirmation
  --acknowledge-network-risk
                           Required for non-localhost binding
  --no-start              Install without starting the stack

Update options:
  --check                 Check without changing the installation
  --to VERSION            Update to an exact version
  --channel stable|rc     Select stable or explicitly opt in to RC

Enable/disable options:
  --now                   Also start or stop the stack now

Uninstall options:
  --purge                 Delete volumes only after literal PURGE confirmation
  --confirm-purge PURGE   Non-interactive destructive confirmation

Restore options:
  --bin-dir PATH          Command directory on this recovery host
  --confirm RESTORE       Non-interactive destructive confirmation

Security:
  Achelife has no login boundary. Keep the default localhost binding, or use
  only a trusted private network or private VPN. Anyone with network access
  can read and change the instance.
EOF
}

parse_global_arguments()
{
    REQUESTED_INSTALL_DIR=""

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --dir)
                require_option_value "$1" "${2:-}"
                REQUESTED_INSTALL_DIR="$2"
                shift 2
                ;;
            --help|-h)
                print_help
                exit 0
                ;;
            --)
                shift
                break
                ;;
            -*) break ;;
            *) break ;;
        esac
    done

    COMMAND="${1:-help}"
    [ "$#" -eq 0 ] || shift
    set_installation_paths "$REQUESTED_INSTALL_DIR"
    dispatch_command "$COMMAND" "$@"
}

dispatch_command()
{
    command_name="$1"
    shift

    case "$command_name" in
        install) command_install "$@" ;;
        start) command_start "$@" ;;
        stop) command_stop "$@" ;;
        restart) command_restart "$@" ;;
        status) command_status "$@" ;;
        update) command_update "$@" ;;
        enable) command_enable "$@" ;;
        disable) command_disable "$@" ;;
        logs) command_logs "$@" ;;
        doctor) command_doctor "$@" ;;
        backup) command_backup "$@" ;;
        restore) command_restore "$@" ;;
        open) command_open "$@" ;;
        version) command_version "$@" ;;
        uninstall) command_uninstall "$@" ;;
        help) print_help ;;
        *) fail "Unknown command: $command_name. Run 'achelife help'." ;;
    esac
}

parse_global_arguments "$@"
