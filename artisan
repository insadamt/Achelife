#!/usr/bin/env php
<?php

use Illuminate\Foundation\Application;
use Symfony\Component\Console\Input\ArgvInput;

define('LARAVEL_START', microtime(true));

if (($argv[1] ?? null) === 'serve') {
    // The PHP child server reads upload limits only when it starts.
    $existingScanDirectories = getenv('PHP_INI_SCAN_DIR');
    $uploadScanDirectories = ($existingScanDirectories === false ? '' : $existingScanDirectories).':'.__DIR__.'/config/php';
    putenv('PHP_INI_SCAN_DIR='.$uploadScanDirectories);
    $_SERVER['PHP_INI_SCAN_DIR'] = $uploadScanDirectories;
    unset($_ENV['PHP_INI_SCAN_DIR']);
}

// Register the Composer autoloader...
require __DIR__.'/vendor/autoload.php';

// Bootstrap Laravel and handle the command...
/** @var Application $app */
$app = require_once __DIR__.'/bootstrap/app.php';

$status = $app->handleCommand(new ArgvInput);

exit($status);
